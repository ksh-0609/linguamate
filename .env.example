# Copy this file to .env and edit the values. NEVER commit .env itself.
APP_NAME=LinguaMate
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (used by Docker Compose AND by the application) ---
# Use only letters and digits in the password (no $ # " ' or spaces).
POSTGRES_USER=linguamate
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=linguamate
POSTGRES_HOST=localhost
POSTGRES_PORT=15432